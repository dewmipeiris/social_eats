rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(tableId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/tables/$(tableId)).data.attendeeIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;

      match /activity/{itemId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /rsvps/{rsvpId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /tables/{tableId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.capacity >= 2
        && request.resource.data.capacity <= 8
        && request.resource.data.attendeeIds.size() <= request.resource.data.capacity;

      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['attendeeIds', 'attendeeNames', 'seatsFilled'])
          && request.resource.data.attendeeIds.size() <= resource.data.capacity)
        ||
        (request.auth.uid == resource.data.hostId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startTime']))
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.hostId;

      match /messages/{messageId} {
        allow read: if isMember(tableId);
        allow create: if isMember(tableId) && request.resource.data.senderId == request.auth.uid;
      }

      match /receipts/{userId} {
        allow read, write: if signedIn() && request.auth.uid == userId && isMember(tableId);
      }

      match /ratings/{ratingId} {
        allow read: if isMember(tableId);
        allow create: if isMember(tableId) && request.resource.data.raterId == request.auth.uid;
      }
    }
  }
}
